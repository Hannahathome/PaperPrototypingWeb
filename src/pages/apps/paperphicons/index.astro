---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import { getTool } from '../../../data/tools';
import { PREVIEW_COLOURS } from '../../../lib/preview';
import { withBase } from '../../../lib/paths';
import { DEFAULT_BLOCK } from '../../../tools/paperphicons/core/block';

const tool = getTool('paperphicons');
const d = DEFAULT_BLOCK;
---

<StarlightPage
	frontmatter={{
		title: 'PaperPhicons',
		description: 'Make print-and-cut blocks that carry ArUco markers, so a camera can track them.',
		tableOfContents: false,
	}}
>
	<p class="intro">
		A basic web version of PaperPhicons: paper blocks (cuboids) with an ArUco marker, so a camera can track them. Each
		copy gets the next marker id. Its nets match the <a href={tool.processingUrl}>Processing version</a>. Print at <strong
			>actual size</strong
		>: detection depends on the marker being printed exactly. First time? Use the <a
			href={withBase('apps/calibration/')}>calibration test sheet</a
		>.
	</p>

	<div class="app not-content">
		<form id="controls" class="controls" onsubmit="return false">
			<fieldset>
				<legend>Block</legend>
				<label>Width (mm) <input id="width" type="number" min="1" max="100" step="1" value={d.width} /></label>
				<label>Length (mm) <input id="length" type="number" min="1" max="100" step="1" value={d.length} /></label>
				<label>Height (mm) <input id="height" type="number" min="1" max="100" step="1" value={d.height} /></label>
				<label>Copies <input id="copies" type="number" min="1" max="16" step="1" value={d.copies} /></label>
			</fieldset>

			<fieldset>
				<legend>Marker</legend>
				<label>First marker id (0–1023) <input id="firstMarkerId" type="number" min="0" max="1023" step="1" value={d.firstMarkerId} /></label>
				<label>Marker size (mm) <input id="markerSize" type="number" min="5" max="50" step="1" value={d.markerSize} /></label>
				<label>
					Marker on
					<select id="markerFace">
						<option value="base" selected={!d.markerOnSide}>Base (width × length)</option>
						<option value="side" selected={d.markerOnSide}>Side wall (height × length)</option>
					</select>
				</label>
				<p class="hint">The size is the black square. A white margin of one cell (size ÷ 7) is added around it; keep it clear.</p>
			</fieldset>

			<fieldset>
				<legend>Export</legend>
				<label>File name <input id="name" type="text" value="paperphicons" /></label>
				<button id="export" type="button">Download PDF + cut files</button>
				<p id="status" role="status"></p>
			</fieldset>
		</form>

		<div class="views">
			<dl id="facts" class="facts"></dl>
			<div id="notes" class="notes" role="note" hidden></div>

			<figure>
				<div id="sheet" class="sheet"></div>
				<figcaption>
					<span style={`--c: ${PREVIEW_COLOURS.cut}`} class="key solid">Cut</span>
					<span style={`--c: ${PREVIEW_COLOURS.fold}`} class="key dashed">Fold</span>
					<span style={`--c: ${PREVIEW_COLOURS.cutArea}`} class="key dashed">Cutting area, 280 × 200 mm</span>
				</figcaption>
			</figure>

			<figure>
				<div id="view3d" class="view3d" aria-label="3D preview of the first block. Drag to rotate, scroll to zoom."></div>
				<figcaption>
					The first block, folded. Drag to rotate, scroll to zoom. <button id="resetView" type="button" class="link">Reset view</button>
				</figcaption>
			</figure>
		</div>
	</div>
</StarlightPage>

<script>
	import { startApp } from '../../../tools/paperphicons/ui/app';

	startApp();
</script>

<style is:global>
	:root {
		--sl-content-width: 76rem;
	}
</style>

<style>
	.app {
		display: grid;
		grid-template-columns: minmax(15rem, 19rem) 1fr;
		gap: 1.5rem;
		align-items: start;
		margin-top: 1.5rem;
	}
	@media (max-width: 60rem) {
		.app {
			grid-template-columns: 1fr;
		}
	}
	.controls {
		display: grid;
		gap: 1rem;
	}
	/* The label/fieldset display rules below would otherwise override the hidden attribute. */
	.app [hidden] {
		display: none !important;
	}
	fieldset {
		display: grid;
		gap: 0.6rem;
		margin: 0;
		padding: 0.75rem 1rem 1rem;
		border: 1px solid var(--sl-color-gray-5);
	}
	legend {
		padding: 0 0.3rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	label {
		display: grid;
		gap: 0.25rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-2);
	}
	label.check {
		display: flex;
		align-items: center;
		gap: 0.5rem;
	}
	input[type='number'],
	input[type='text'],
	select {
		width: 100%;
		padding: 0.35rem 0.5rem;
		border: 1px solid var(--sl-color-gray-4);
		border-radius: 0.25rem;
		background: var(--sl-color-black);
		color: var(--sl-color-white);
		font: inherit;
	}
	input:disabled {
		opacity: 0.5;
	}
	input[type='file'] {
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.hint {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
	}
	#export {
		padding: 0.5rem 1rem;
		border: 0;
		border-radius: 999px;
		background-color: var(--sl-color-text-accent);
		color: var(--sl-color-black);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	#export:disabled {
		opacity: 0.6;
		cursor: progress;
	}
	#status {
		margin: 0;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
	.views {
		display: grid;
		gap: 1rem;
		min-width: 0;
	}
	.facts {
		display: grid;
		grid-template-columns: auto 1fr;
		gap: 0.2rem 1rem;
		margin: 0;
		font-size: var(--sl-text-sm);
	}
	.facts :global(dt) {
		color: var(--sl-color-gray-3);
	}
	.facts :global(dd) {
		margin: 0;
		color: var(--sl-color-white);
		font-variant-numeric: tabular-nums;
	}
	.notes {
		padding: 0.6rem 0.9rem;
		border-left: 3px solid var(--sl-color-orange);
		background: var(--sl-color-orange-low);
		font-size: var(--sl-text-sm);
	}
	.notes :global(p) {
		margin: 0.2rem 0;
	}
	figure {
		margin: 0;
	}
	.sheet :global(svg) {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid var(--sl-color-gray-5);
	}
	.view3d {
		height: 24rem;
		border: 1px solid var(--sl-color-gray-5);
		background: radial-gradient(circle at 50% 35%, #ffffff, #d9dde3);
		touch-action: none;
	}
	.view3d :global(canvas) {
		display: block;
		width: 100%;
		height: 100%;
	}
	figcaption {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.4rem 1.25rem;
		margin-top: 0.4rem;
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-2);
	}
	.key::before {
		content: '';
		display: inline-block;
		width: 1.5rem;
		margin-right: 0.4rem;
		vertical-align: middle;
		border-top: 2px solid var(--c);
	}
	.key.dashed::before {
		border-top-style: dashed;
	}
	button.link {
		padding: 0;
		border: 0;
		background: none;
		color: var(--sl-color-text-accent);
		font: inherit;
		text-decoration: underline;
		cursor: pointer;
	}
</style>
